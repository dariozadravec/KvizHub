@page "/my-reservations"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Moje rezervacije | KvizHub</PageTitle>

<h1 class="mb-4">Moje rezervacije</h1>

@if (loadError is not null)
{
    <div class="alert alert-secondary">@loadError</div>
}
else if (reservations is null)
{
    <p>Nalaganje …</p>
}
else if (reservations.Count == 0)
{
    <p class="text-muted">Nimate še nobene rezervacije. <a href="events">Poiščite kviz</a>.</p>
}
else
{
    @foreach (var reservation in reservations)
    {
        var isCancelled = reservation.Status == ReservationStatus.Cancelled;
        var canCancel = reservation.Status == ReservationStatus.Confirmed && reservation.EventStatus == EventStatus.Published;

        <div class="border rounded p-3 mb-3 @(isCancelled ? "bg-light" : "")">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <a href="events/@reservation.EventId" class="fw-bold text-dark">@reservation.EventTitle</a>
                    <div class="small text-muted">@reservation.EventStartsAt.ToLocalTime().ToString("d. M. yyyy 'ob' HH:mm")</div>
                    <div class="small">Ekipa: @reservation.TeamName, število članov: @reservation.TeamSize</div>
                </div>
                <span class="badge @(isCancelled ? "border text-muted" : "text-bg-secondary")">
                    @ReservationStatusText.Label(reservation.Status)
                </span>
            </div>

            @if (canCancel)
            {
                <button class="btn btn-outline-danger btn-sm mt-3" disabled="@(busyReservationId == reservation.Id)"
                        @onclick="() => CancelAsync(reservation)">
                    Prekliči rezervacijo
                </button>
            }

            @if (errors.TryGetValue(reservation.Id, out var error))
            {
                <div class="text-danger small mt-2">@error</div>
            }
        </div>
    }
}

@code {
    private List<ReservationDto>? reservations;
    private string? loadError;
    private int? busyReservationId;
    private readonly Dictionary<int, string> errors = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            reservations = await Http.GetFromJsonAsync<List<ReservationDto>>("api/reservations/mine");
        }
        catch (HttpRequestException)
        {
            loadError = "Seznama rezervacij ni mogoče naložiti.";
        }
    }

    private async Task CancelAsync(ReservationDto reservation)
    {
        // Asks for confirmation before cancelling (US-07 K3)
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Ali res želite preklicati rezervacijo ekipe {reservation.TeamName} za dogodek „{reservation.EventTitle}“?");
        if (!confirmed)
            return;

        busyReservationId = reservation.Id;
        errors.Remove(reservation.Id);

        try
        {
            var response = await Http.PostAsync($"api/reservations/{reservation.Id}/cancel", null);

            if (response.IsSuccessStatusCode)
            {
                await LoadAsync();
            }
            else
            {
                var problem = await response.Content.ReadFromJsonAsync<ProblemResponse>();
                errors[reservation.Id] = problem?.Detail ?? "Preklic ni uspel.";
            }
        }
        catch (HttpRequestException)
        {
            errors[reservation.Id] = "Strežnik ni dosegljiv. Poskusite znova.";
        }
        finally
        {
            busyReservationId = null;
        }
    }

    // Shape of the problem details returned by the API
    private sealed record ProblemResponse(string? Detail);
}