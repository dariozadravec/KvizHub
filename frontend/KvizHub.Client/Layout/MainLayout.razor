@inherits LayoutComponentBase
@inject HttpClient Http
@inject ApiAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<header class="bg-light border-bottom">
    <div class="container app-container py-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="" class="fs-4 fw-bold text-dark text-decoration-none">KvizHub</a>

            <AuthorizeView>
                <Authorized>
                    <span class="small text-muted">@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <Authorized>
                <nav class="d-flex flex-wrap gap-3 mt-2 small">
                    @if (context.User.IsInRole(nameof(UserRole.Quizmaster)))
                    {
                        <a href="my-events">Moji dogodki</a>
                        <a href="events/new">Nov dogodek</a>
                    }
                    @if (context.User.IsInRole(nameof(UserRole.TeamLeader)))
                    {
                        <a href="events">Iskalnik</a>
                        <a href="my-reservations">Moje rezervacije</a>
                    }
                    <button class="btn btn-link btn-sm p-0 ms-auto" @onclick="LogoutAsync">Odjava</button>
                </nav>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<main class="container app-container py-4">
    @Body
</main>

@code {
    private async Task LogoutAsync()
    {
        await Http.PostAsync("api/auth/logout", null);
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("login");
    }
}